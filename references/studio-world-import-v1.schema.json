{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neta.art/schemas/studio-world-import-v1.schema.json",
  "title": "Neta Studio Book Import V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["worldConfig", "atoms"],
  "properties": {
    "worldConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "overview", "language", "creationMode", "sections"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "genre": { "type": "string", "minLength": 1 },
        "tone": { "type": "string", "minLength": 1 },
        "era": { "type": "string", "minLength": 1 },
        "rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "overview": { "type": "string", "minLength": 1 },
        "prologue": { "type": "string", "minLength": 1 },
        "coreConflict": { "type": "string", "minLength": 1 },
        "visualStyle": { "type": "string", "minLength": 1 },
        "language": { "enum": ["zh", "en"] },
        "creationMode": { "const": "book-import" },
        "sections": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/worldSection" } },
        "sectionBodies": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "sectionTitles": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "backgroundPresetId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "worldCover": { "type": "string", "format": "uri", "minLength": 1 }
      }
    },
    "atoms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/atomInput" } }
  },
  "$defs": {
    "worldSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 50 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "contentField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "atomInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "description", "content", "tags"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 50 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentField" } },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
